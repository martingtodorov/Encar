{{ ansible_managed | comment }}
# Written by Ansible from group_vars. Do not edit on the server: the next run overwrites it.

SITE_DOMAIN={{ site_domain }}
LETSENCRYPT_EMAIL={{ letsencrypt_email }}
PUBLIC_SITE_URL=https://{{ site_domain }}
CORS_ORIGINS=https://{{ site_domain }}
DB_NAME={{ db_name | default('encar') }}
WITH_PLAYWRIGHT={{ with_playwright | default(0) }}

ADMIN_TOKEN={{ admin_token }}
ADMIN_SEED_PASSWORD={{ admin_seed_password | default('') }}
TOTP_ENCRYPTION_KEY={{ totp_encryption_key }}

ANTHROPIC_API_KEY={{ anthropic_api_key }}
ANTHROPIC_MODEL={{ anthropic_model | default('claude-sonnet-4-6') }}
GEMINI_API_KEY={{ gemini_api_key | default('') }}
GEMINI_MODEL={{ gemini_model | default('gemini-3-flash') }}

STRIPE_SECRET_KEY={{ stripe_secret_key | default('') }}
STRIPE_PUBLISHABLE_KEY={{ stripe_publishable_key | default('') }}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret | default('') }}
STRIPE_MODE={{ stripe_mode | default('test') }}
COMMISSION_EUR={{ commission_eur | default(0) }}

RESEND_API_KEY={{ resend_api_key | default('') }}
SENDER_EMAIL={{ sender_email | default('') }}
ADMIN_NOTIFY_EMAIL={{ admin_notify_email | default('') }}

JSONCARGO_API_KEY={{ jsoncargo_api_key | default('') }}
JSONCARGO_SHIPPING_LINE={{ jsoncargo_shipping_line | default('') }}
MAERSK_PUBLIC_TRACK={{ maersk_public_track | default(0) }}
EDI_INGEST_TOKEN={{ edi_ingest_token | default('') }}
CUSTOMS_LEAD_DAYS={{ customs_lead_days | default(4) }}
DELIVERY_LEAD_DAYS={{ delivery_lead_days | default(7) }}

VAPID_PUBLIC_KEY={{ vapid_public_key | default('') }}
VAPID_PRIVATE_KEY={{ vapid_private_key | default('') }}
VAPID_SUBJECT={{ vapid_subject | default('mailto:' ~ letsencrypt_email) }}

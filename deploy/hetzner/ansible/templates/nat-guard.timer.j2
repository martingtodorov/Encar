[Unit]
Description={{ app_name }}: check the tunnel's policy routing every {{ nat_guard_interval }}s

[Timer]
OnBootSec=30s
# Inactive, not Active: a slow run must not overlap with the next one.
OnUnitInactiveSec={{ nat_guard_interval }}s
AccuracySec=5s
Unit={{ app_name }}-nat-guard.service

[Install]
WantedBy=timers.target

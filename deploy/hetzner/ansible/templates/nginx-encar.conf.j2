# Written by Ansible. One build, every brand domain — the app picks its language from the
# hostname and the URL prefix, so nothing here is per-domain.

# Real visitor addresses behind Cloudflare, or every rate limit and audit line would read a
# Cloudflare edge IP.
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# Chat apps and social networks never run our JavaScript, so the og:* tags the car page
# writes at runtime are invisible to them and a pasted link previews as nothing. These
# clients are sent to /api/share/car/{id}, which carries the ad's OWN first photo at
# 1200x630 in the HTML. A human is never touched by this.
#
# iMessage note: Apple's own crawler for a link pasted into Messages is NOT the "Applebot"
# search bot - Messages fetches metadata with `com.apple.WebKit.Networking` (the system
# HTTP client) and the head-only fetch that follows also carries that string. Without it
# on the list, iMessage lands on the SPA shell and picks up whatever fallback og:image
# lives in index.html (our logo), which is exactly the "preview is a logo not the car"
# report from users. `Applebot-Extended` covers Apple's newer AI/preview crawler too.
map $http_user_agent $encar_crawler {
    default 0;
    "~*(facebookexternalhit|facebookcatalog|Facebot|Twitterbot|Slackbot|WhatsApp|Viber|TelegramBot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|redditbot|vkShare|Applebot|Applebot-Extended|com\.apple\.WebKit\.Networking|WebKit/[0-9.]+ .*Preview|Iframely|embedly|Snapchat|Instagram|Mastodon|Bluesky|Google-InspectionTool)" 1;
    # Apple's iOS/macOS iMessage link-preview fetcher, iOS 16+: a headless WebKit whose UA
    # is a Safari base with NO trailing `Version/X` and NO `Safari/X` markers. A real Safari
    # (iPhone or Mac) ALWAYS carries both. Matching UAs that end at "(KHTML, like Gecko)"
    # (with an optional trailing space) singles out the headless fetcher without touching
    # any real browser. Observed with iOS 17 Messages against fem.encar.com's own logs.
    "~*AppleWebKit/[0-9.]+ \(KHTML, like Gecko\)\s*$" 1;
}

upstream {{ app_name }}_backend {
    server encar-back1:8001 max_fails=0;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {% for d in site_domains %}{{ d }} www.{{ d }} {% endfor %};

    # Prepared in case Let's Encrypt is ever wanted; no certbot is installed.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

{% for d in site_domains %}
server {
{% if nginx_version is version('1.25.1', '>=') %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{% else %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% endif %}
    server_name www.{{ d }};
    ssl_certificate     {{ ssl_dir }}/cert.pem;
    ssl_certificate_key {{ ssl_dir }}/key.pem;
    return 301 https://{{ d }}$request_uri;
}
{% endfor %}

server {
{% if nginx_version is version('1.25.1', '>=') %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{% else %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% endif %}
    server_name {% for d in site_domains %}{{ d }} {% endfor %};

    ssl_certificate     {{ ssl_dir }}/cert.pem;
    ssl_certificate_key {{ ssl_dir }}/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root {{ web_root }}/build;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 32m;

    # ── the API ───────────────────────────────────────────────────────────────
    location ^~ /api/ {
        proxy_pass http://{{ app_name }}_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP  $http_cf_connecting_ip;
        proxy_set_header Connection        "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # The dealer-description translation is streamed over SSE — buffering it would hold
        # the whole answer back and the visitor would watch a spinner instead of words.
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Archived photos of purchased cars. Immutable once written, so they are cached hard.
    location /api/media/ {
        proxy_pass http://{{ app_name }}_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_cache_valid 200 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    # ── the app ───────────────────────────────────────────────────────────────
    location ^~ /static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Fingerprinted static assets (self-hosted fonts, hashed logo files) never change under
    # the same URL - a new build ships a new hash. Same treatment as /static/: cache them
    # for a year and mark immutable so the browser skips revalidation entirely. The 4 h
    # default that Lighthouse flagged came from the SPA fallback below (`try_files ...
    # /index.html`) picking up its no-cache heuristic for anything without a location match.
    location ^~ /fonts/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~* ^/logo-\d+\.(webp|png)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    # PWA icons, favicons and the OG plate are also content-hashed by name; safe to cache hard.
    location ~* ^/(favicon\.(ico|png)|og\.png|icons/.*)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # A pinned service worker would serve a broken build forever.
    location = /service-worker.js {
        add_header Cache-Control "no-store";
    }

    # Sitemap: a dynamic index in the backend that fans out into child sitemaps for the
    # static pages, every make/model landing and (chunked in 40 000-URL blocks) every
    # active listing. `robots.txt` is still the static file next to the build.
    #
    # Google fetches `/sitemap.xml`, follows to `/sitemap-listings-{n}.xml`, and expects
    # both to end in .xml at the root; a `/api/…` path is fine as a proxy target but the
    # public loc must not carry it, which is why every child <loc> the index writes uses
    # the root path and gets rewritten here.
    location ~ ^/sitemap(-[a-z]+(-[0-9]+)?)?\.xml$ {
        proxy_pass http://{{ app_name }}_backend/api$uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /robots.txt  { try_files $uri =404; }

    # A car link pasted into Viber/Messenger/WhatsApp/Facebook: the crawler gets the share
    # page (og:image = the ad's first photo), a person gets the app exactly as before.
    location ~ ^/(bg|ro|en)/car/([^/]+)/?$ {
        # The captures are copied out FIRST: nginx clears $1/$2 inside an `if`, which sent the
        # crawler to /api/share/car/?lang= and answered 404.
        set $share_lang $1;
        set $share_id $2;
        if ($encar_crawler) {
            proxy_pass http://{{ app_name }}_backend/api/share/car/$share_id?lang=$share_lang;
        }
        # Everyone else - visitors and search engines alike - gets the server-rendered ad.
        try_files /__prerender @prerender;
    }

    # The Track page: the crawler gets a page whose og:image is the shipment's own route drawn
    # on OpenStreetMap tiles (backend/mapshot.py). `$args` carries ?ref=&by= through.
    location ~ ^/(bg|ro|en)/track/?$ {
        set $share_lang $1;
        if ($encar_crawler) {
            proxy_pass http://{{ app_name }}_backend/api/share/track?lang=$share_lang&$args;
        }
        try_files /__prerender @prerender;
    }

    # Every route is client side: /bg, /ro, /en and everything under them.
    #
    # Apex (naked `/`) is a permanent redirect to the Bulgarian skin so the site has one
    # canonical home in Google's index rather than three duplicate "landing" URLs (`/`,
    # `/bg`, `/bg/`). Client-side geolocation on the Bulgarian page can still move a
    # Romanian or English visitor onwards, but that redirect is a soft 302 in JS - it
    # does not muddle canonicalization.
    location = / {
        return 301 /bg;
    }

    # Every page is SERVER-RENDERED by the backend (backend/prerender.py): the raw HTML for
    # an ad carries its own title, description, canonical, hreflang, H1, price, photos and
    # Vehicle/Offer/BreadcrumbList schema, and a missing ad answers a real 404 (a sold one a
    # 410) instead of a 200 with an empty React shell. Anything WITHOUT a file extension is
    # an app route and comes through here; assets (they all carry a dot) fall through to the
    # static block below. `^~` on /api/, /static/ and /fonts/ above keeps this regex off them.
    location ~ ^/[^.]*$ {
        try_files /__prerender @prerender;
    }

    location @prerender {
        proxy_pass http://{{ app_name }}_backend/api/prerender?path=$uri&$args;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        # If the backend cannot render (down, restarting, no shell yet) the visitor still
        # gets the app: the plain SPA shell, exactly as before this existed.
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @spa;
    }

    location @spa {
        try_files /index.html =404;
    }

    location / {
        # Assets with an extension: the hashed bundles, images, manifest and the per-language
        # index.html files gen-lang-html.js writes (the fallback when the backend is down).
        try_files $uri $uri/index.html /index.html;
    }
}

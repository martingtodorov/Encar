# Written by Ansible from group_vars. Do not edit on the server: the next deploy overwrites it.
MONGO_URL={{ mongo_url }}
DB_NAME={{ db_name }}
PUBLIC_SITE_URL=https://{{ site_domains[0] }}
CORS_ORIGINS={% for d in site_domains %}https://{{ d }}{% if not loop.last %},{% endif %}{% endfor %}

MEDIA_ROOT={{ media_dir }}

ADMIN_TOKEN={{ admin_token }}
ADMIN_SEED_PASSWORD={{ admin_seed_password }}
TOTP_ENCRYPTION_KEY={{ totp_encryption_key }}

ANTHROPIC_API_KEY={{ anthropic_api_key | default('') }}
# Admin (organisation) key, prefix sk-ant-admin... . ONLY used to read the invoiced spend
# from /v1/organizations/cost_report for the admin "AI разходи" screen; it never translates
# anything. Left empty the panel simply shows our own list-price estimate.
ANTHROPIC_ADMIN_KEY={{ anthropic_admin_key | default('') }}
ANTHROPIC_MODEL={{ anthropic_model | default('claude-haiku-4-5-20251001', true) }}
# `default(x, true)` fires on an empty value too, not only on undefined - so a
# blank group_vars entry does not sneak an empty string into the env, which then
# breaks Python's `os.environ.get("KEY", fallback)` (the env IS set, just empty,
# so the fallback never fires and the empty string reaches Anthropic → 400).
ANTHROPIC_FAST_MODEL={{ anthropic_fast_model | default('claude-haiku-4-5-20251001', true) }}
# Taxonomy-only model. Every marque, model, submodel and trim value on the site is
# translated through this - a wrong spelling here writes to the permanent cache and
# then repeats across the whole catalogue, so this narrow slice deliberately uses
# Sonnet even though the rest of the app is on Haiku.
ANTHROPIC_TAXONOMY_MODEL={{ anthropic_taxonomy_model | default('claude-sonnet-5', true) }}
GEMINI_API_KEY={{ gemini_api_key | default('') }}
GEMINI_MODEL={{ gemini_model | default('gemini-2.5-flash', true) }}

STRIPE_SECRET_KEY={{ stripe_secret_key }}
STRIPE_PUBLISHABLE_KEY={{ stripe_publishable_key }}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret }}
STRIPE_MODE={{ stripe_mode }}
STRIPE_ACCOUNT_ID={{ stripe_account_id }}

RESEND_API_KEY={{ resend_api_key }}
SENDER_EMAIL={{ sender_email }}
OWNER_EMAIL={{ owner_email | default('') }}
OWNER_PASSWORD={{ owner_password | default('') }}
ADMIN_NOTIFY_EMAIL={{ admin_notify_email }}

JSONCARGO_API_KEY={{ jsoncargo_api_key }}
{# `default(x, true)` fires on an EMPTY value too, not only an undefined one: group_vars that
   were copied from the example and left blank must not reach the server as an empty carrier,
   which JSONCargo rejects with 400 on every container lookup. #}
JSONCARGO_SHIPPING_LINE={{ jsoncargo_shipping_line | default('MAERSK', true) }}
EDI_INGEST_TOKEN={{ edi_ingest_token }}
MAERSK_PUBLIC_TRACK={{ maersk_public_track }}

# The mobile.bg posting bot authenticates with this on /api/post-queue.
ENCAREUROPE_API_TOKEN={{ encareurope_api_token }}

# One fixed HTTP proxy for api.encar.com only (CloudFront answers 407 to datacenter address
# space). Derived from the home exit when one is configured; CDN images are never proxied.
ENCAR_PROXY_URL={{ encar_proxy_url | default(
  ('http://' ~ home_exit_ip | default('10.99.0.3') ~ ':' ~ home_exit_proxy_port | default(8888))
  if (home_exit_pubkey | default('') | trim | length > 0) else '', true) }}

VAPID_PUBLIC_KEY={{ vapid_public_key }}
VAPID_PRIVATE_KEY={{ vapid_private_key }}
VAPID_SUBJECT={{ vapid_subject }}

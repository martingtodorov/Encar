---
# Copy to group_vars/all.yml, fill in, then:  ansible-vault encrypt group_vars/all.yml
# Nothing here is ever committed. The playbooks refuse to run without the first three.

# ── identity ──────────────────────────────────────────────────────────────────
app_name: encar
# Every domain this build answers on. The first one is the canonical site URL used in
# emails, share links, sitemap.xml and robots.txt.
site_domains:
  - encareurope.com

# Where things live on the hosts (mirrors the Auto&Bid layout).
app_dir: /opt/encar                  # backend releases + venv
web_root: /var/www/encar             # frontend releases + the `build` symlink
env_dir: /etc/encar                  # backend.env
media_dir: /var/lib/encar/media      # archived photos of purchased cars (PERSISTENT)
ssl_dir: /etc/ssl/encar              # Cloudflare Origin cert.pem + key.pem (dropped by hand)

# Code source. "Save to GitHub" in Emergent gives you this; deploy with -e ref=main.
repo_url: git@github.com:you/europe-encar.git
ref: main

# The port YOUR sshd listens on — the firewall opens this one and nothing else from the
# internet. Set it before the first run or you will lock yourself out.
ssh_port: 22
private_cidr: 10.0.0.0/16
# back1 has no public IPv4, so it leaves through front1 (deploy_nat.yml). This is front1's
# address ON THE PRIVATE NETWORK — it is the WireGuard endpoint back1 dials, NOT a default
# gateway: Hetzner hands out /32 private addresses, so 10.0.0.2 is not a valid L2 next hop.
frontend_private_ip: 10.0.0.2
# The interface on front1 that faces the internet. Left unset it is taken from facts, which
# is right on a standard Hetzner box (eth0 / enp1s0).
# nat_public_iface: eth0

# The point-to-point tunnel that carries the backend's outbound traffic to front1. The port
# is opened ONLY from backend_private_ip to frontend_private_ip, never on the public side.
# ALL of the following are OPTIONAL — deploy_nat.yml falls back to exactly these values.
wg_port: 51820
wg_front_ip: 10.99.0.1
wg_back_ip: 10.99.0.2
# Hetzner's private network is MTU 1450; WireGuard's own overhead is 80 bytes.
wg_mtu: 1370
# Policy routing on back1: traffic owned by this user is looked up (by UID) in nat_table,
# whose default points into the tunnel. Must match User= in the unit file.
backend_service_user: www-data
nat_table: 100
nat_mark: "0x1"
nat_rule_priority: 1000
# back1 has no public IPv4, so root (apt, git clone, pip, DNS) has no way out unless it also
# takes the tunnel. `true` adds a second rule for everything else; the private network
# (SSH via front1), link-local and RFC1918 stay on Hetzner's own route regardless.
nat_route_management: true
# Encar's CloudFront answers 407 to datacenter addresses (Hetzner included) and 200 to a home
# connection. The owner's Mac mini is a third WireGuard peer that runs an HTTP proxy; back1
# sends api.encar.com — and nothing else — through it. Run deploy/hetzner/home-exit/setup-mac.sh
# on the Mac and paste the public key it prints here, then re-run deploy_nat.yml and
# deploy_backend.yml --tags config,service.
# home_exit_pubkey: ""
# home_exit_ip: 10.99.0.3
# home_exit_proxy_port: 8888
# encar_proxy_url: http://10.99.0.3:8888      # derived from the two above when unset

# ── backend secrets ───────────────────────────────────────────────────────────
db_name: encar
mongo_url: mongodb://localhost:27017

# openssl rand -base64 24
admin_token: ""
admin_seed_password: ""
# openssl rand -base64 32
totp_encryption_key: ""

# Your OWN key: the Emergent universal key does not work off-platform. Claude does every
# translation in this app.
anthropic_api_key: ""
# Organisation Admin key (console.anthropic.com → Settings → Admin keys), prefix
# sk-ant-admin... . Read-only, used ONLY by the admin "AI разходи" screen to show the amount
# Anthropic actually invoices per day. Optional: empty = our own estimate is shown instead.
anthropic_admin_key: ""
anthropic_model: claude-haiku-4-5-20251001
anthropic_fast_model: claude-haiku-4-5-20251001
gemini_api_key: ""
gemini_model: gemini-2.5-flash

stripe_secret_key: ""
stripe_publishable_key: ""
stripe_webhook_secret: ""
stripe_mode: live
stripe_account_id: ""

resend_api_key: ""
sender_email: "contact@encareurope.com"
admin_notify_email: "contact@encareurope.com"

# The owner's own account. Seeded at startup: the admin flag is re-applied every restart, the
# password only when the account has none, so a password changed in the profile survives.
owner_email: "you@example.com"
owner_password: ""

jsoncargo_api_key: ""
# The carrier is a REQUIRED query parameter on every container lookup - JSONCargo answers 400
# without it. Leave the value spelled out; an empty string here reaches the backend as an empty
# env var, which beats the code's own MAERSK default.
jsoncargo_shipping_line: "MAERSK"
# The mobile.bg posting bot sends this as `Authorization: Bearer <token>` on /api/post-queue.
# It is REQUIRED — deploy_backend.yml rewrites backend.env from this file on every deploy, so
# a missing value here wipes the token off the server and the bot starts getting 401/503.
encareurope_api_token: ""
# Optional. Empty simply switches the direct carrier EDI feed off; JSONCargo covers tracking
# on its own.
edi_ingest_token: ""
# Reading Maersk's public page needs an egress IP Akamai accepts; it is OFF here.
maersk_public_track: 0

vapid_public_key: ""
vapid_private_key: ""
vapid_subject: "mailto:you@example.com"

# ── behaviour ─────────────────────────────────────────────────────────────────
releases_kept: 5
node_major: 20
mongo_major: "7.0"
backup_dir: /var/backups/encar

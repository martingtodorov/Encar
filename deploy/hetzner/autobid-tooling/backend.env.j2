# Written by Ansible from group_vars/secrets. Do not edit on the server: the next deploy
# overwrites it. Variable names follow the Auto&Bid tooling (secrets_dir, upload_dir, domains).
#
# The three at the top are read at IMPORT time — a missing one kills uvicorn before it binds
# port 8001, and the deploy then fails with nothing but "connection refused".
MONGO_URL={{ mongo_url | default('mongodb://localhost:27017') }}
DB_NAME={{ db_name | default('encar') }}
MEDIA_ROOT={{ media_dir | default('/var/lib/encar/media') }}

PUBLIC_SITE_URL=https://{{ primary_domain }}
CORS_ORIGINS={% for d in domains %}https://{{ d }}{% if not loop.last %},{% endif %}{% endfor %}

ADMIN_TOKEN={{ admin_token }}
ADMIN_SEED_PASSWORD={{ admin_seed_password }}
TOTP_ENCRYPTION_KEY={{ totp_encryption_key }}

# Claude does every translation. Your OWN key: the Emergent universal key does not work
# off-platform, which is why emergentintegrations is no longer in requirements.txt.
ANTHROPIC_API_KEY={{ anthropic_api_key }}
ANTHROPIC_MODEL={{ anthropic_model | default('claude-sonnet-5') }}
ANTHROPIC_FAST_MODEL={{ anthropic_fast_model | default('claude-haiku-4-5-20251001') }}
GEMINI_API_KEY={{ gemini_api_key | default('') }}
GEMINI_MODEL={{ gemini_model | default('gemini-2.5-flash') }}

STRIPE_SECRET_KEY={{ stripe_secret_key }}
STRIPE_PUBLISHABLE_KEY={{ stripe_publishable_key }}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret }}
STRIPE_MODE={{ stripe_mode | default('live') }}
STRIPE_ACCOUNT_ID={{ stripe_account_id | default('') }}

RESEND_API_KEY={{ resend_api_key | default('') }}
SENDER_EMAIL={{ sender_email | default('') }}
ADMIN_NOTIFY_EMAIL={{ admin_notify_email | default('') }}

JSONCARGO_API_KEY={{ jsoncargo_api_key | default('') }}
JSONCARGO_SHIPPING_LINE={{ jsoncargo_shipping_line | default('') }}
EDI_INGEST_TOKEN={{ edi_ingest_token | default('') }}
# Akamai refuses datacenter IPs, so reading Maersk's public page costs 30s and a Chromium to
# fail. Off means no Playwright is needed anywhere.
MAERSK_PUBLIC_TRACK=0

VAPID_PUBLIC_KEY={{ vapid_public_key | default('') }}
VAPID_PRIVATE_KEY={{ vapid_private_key | default('') }}
VAPID_SUBJECT={{ vapid_subject | default('mailto:' + (admin_notify_email | default('you@example.com'))) }}
